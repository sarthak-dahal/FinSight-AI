{
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv tree *)",
      "Bash(.venv/bin/python *)",
      "Bash(sqlite3 data/finsight.db *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Edit(data/raw/**)",
      "Bash(rm -rf data/raw*)",
      "Bash(rm -r data/raw*)",
      "Read(.env)"
    ]
  }
}
